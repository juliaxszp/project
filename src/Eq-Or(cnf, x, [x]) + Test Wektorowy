
from pysat.solvers import Kissat404
from pysat.formula import CNF, IDPool

cnf = CNF()
idp = IDPool()

names = ['a', 'b', 'c', 'd', 'e', 'f', 'g']

variables = [
    idp.id('a'),
    idp.id('b'),
    idp.id('c'),
    idp.id('d'),
    idp.id('e'),
    idp.id('f'),
    idp.id('g')
]

for name, var in zip(names, variables):
    print(name, ":", var)


def equals(cnf: CNF, variables) -> None:
    first_var = variables[0]

    for next_var in variables[1:]:
        cnf.append([first_var, -next_var])

    clause = [-first_var] + [var for var in variables[1:]]
    cnf.append(clause) 
                
equals(cnf, variables)

print("CNF clauses:", cnf.clauses)

with Kissat404(bootstrap_with=cnf) as solver:
    if solver.solve():
        model = solver.get_model()
        print("Satisfiable. Model:", model)
    else:
        print("Unsatisfiable.")




n = len(variables)

for liczba in range(2**n):
    wektor_bin = bin(liczba)[2:].zfill(n)
    wektor = []
    for bit in wektor_bin:
    
        bit = int(bit)
        wektor.append(bit)
    
    sprawdzenie = any((wektor)[1:])
    first_wektor = wektor[0]
    if sprawdzenie == first_wektor:
        expected = True
    else:
        expected = False

    test_cnf = CNF()
    
    equals(test_cnf, variables)
    for var, value in zip(variables, wektor):
        if value == 1:
            test_cnf.append([var])
        else:
            test_cnf.append([-var])



    with Kissat404(bootstrap_with=test_cnf) as solver:
                result = solver.solve()

                if result == expected:
                    print('Test', wektor, 'OK')
                else: 
                    print('Test', wektor, 'ŹLE, COŚ NIE DZIAŁA')


from pysat.solvers import Kissat404
from pysat.formula import CNF, IDPool

cnf = CNF()
idpool = IDPool()

names = ['a', 'b', 'c', 'd']

n = len(names)

variables = [
    idpool.id('a'),
    idpool.id('b'),
    idpool.id('c'),
    idpool.id('d'),
]

def xor(cnf: CNF, variables, tablica_bin) -> None:
    clause = []
    for var, value in zip(variables, tablica_bin):
        if value == '1':
            clause.append(var)
        else:
            clause.append(-var)

    cnf.append(clause)
    
for tablica in range(0, 2**n):
    tablica_bin = bin(tablica)[2:].zfill(n)
    liczba_jedynek = tablica_bin.count('1')
    reszta = liczba_jedynek % 2

    if reszta == 0:
        continue

    print(tablica_bin)
    
    for name, value in zip(names, tablica_bin):
        
        print(name, ':', value)

    print('------')

    xor(cnf, variables, tablica_bin)

    

print(cnf.clauses)


with Kissat404(bootstrap_with=cnf) as solver:
    if solver.solve():
        model = solver.get_model()
        print('------------------------------')
        print('DZIAŁA I JEST ROZWIĄZANIE!!!!')
        print('rozwiązanie to:', model)
    else:
        print('UNSAT')
        
for liczba in range(2**n):
    wektor_bin = bin(liczba)[2:].zfill(n)

    wektor = []

    for bit in wektor_bin:
        bit = int(bit)
        wektor.append(bit)
    jedynki = wektor.count(1)
    podzielność = jedynki % 2

    if podzielność == 1:
        expected = True
    else:
        expected = False

    test_cnf = CNF()
    for tablica in range(0, 2**n):
        tablica_bin = bin(tablica)[2:].zfill(n)
        liczba_jedynek = tablica_bin.count('1')
        reszta = liczba_jedynek % 2
        if reszta == 0:
            continue

        xor(test_cnf, variables, tablica_bin)
    for var, value in zip(variables, wektor):
        if value == 1:
            test_cnf.append([var])
        else: test_cnf.append([-var])

    with Kissat404(bootstrap_with=test_cnf) as solver:
        result = solver.solve()

        if result == expected:
            print('Test', wektor, expected, 'OK')
        else: 
            print('Test', wektor, expected, 'ŹLE, COŚ NIE DZIAŁA')



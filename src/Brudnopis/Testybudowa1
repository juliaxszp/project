from pysat.solvers import Kissat404

cnf = CNF()
idp = IDPool()

def test(cnf: CNF, var_h, var_w, var_d, var_p) -> None:
    cnf.append([var_h, var_w])
    cnf.append([-var_w, var_d])
    cnf.append([-var_w])
    cnf.append([-var_d, var_p])
    cnf.append([-var_h])

h = idp.id('h')
w = idp.id('w')
d = idp.id('d')
p = idp.id('p')

print("IDs for variables:")
print("h:", h)
print("w:", w)
print("d:", d)
print("p:", p)

test(cnf, h, w, d, p)

print("CNF clauses after test:", cnf.clauses)

with Kissat404(bootstrap_with=cnf) as solver:
    if solver.solve():
        model = solver.get_model()
        print("Satisfiable. Model:", model)
    else:
        print("Unsatisfiable.")
